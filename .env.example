# Copia questo file in .env (ignorato da git) e compila i segreti. Mai committare .env.
# Generare un segreto:  openssl rand -hex 32

# --- Obbligatori ---
JWT_SECRET=
INTERNAL_API_SECRET=
# Chiave con cui Super Admin cifra i propri segreti (credenziali offsite dei backup)
ENCRYPTION_KEY=

# Password dell'utente admin di Super Admin al primo avvio. Se vuota ne viene generata
# una casuale, stampata UNA sola volta nel log di avvio.
INITIAL_ADMIN_PASSWORD=

# --- Sottodomini automatici su Cloudflare (facoltativi) ---
# Senza queste variabili un tenant nuovo nasce senza dominio. Token: Cloudflare > Profilo >
# API Tokens > "Edit zone DNS" limitato alla zona. ORIGIN_IP = IP pubblico che serve i tenant.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ZONE_NAME=
CLOUDFLARE_ORIGIN_IP=

# --- Email di notifica (facoltative: backup riusciti/falliti, tenant eliminato) ---
SMTP_HOST=
SMTP_PORT=25
SMTP_SECURE=false
SMTP_FROM=
NOTIFY_EMAIL_TO=

# --- AI (facoltativa) ---
MISTRAL_API_KEY=
