{
  "_descrizione": "Estensioni di moduli del verticale Mediazione immobiliare, applicate da seed-blocchi-verticale.js (una volta sola per estensione, solo se il modulo e i moduli citati esistono): la provvigione a DUE parti. Sul modulo Provvigioni: parte (venditore/acquirente), percentuale, base imponibile e i calcoli di importo netto, IVA e totale. Sulla Trattativa: venditore e acquirente, una percentuale per parte e un'automazione che, alla firma del preliminare, crea una riga di provvigione per ciascuna parte (una volta sola per trattativa).",
  "provvigioni": [
    {
      "key": "due_parti",
      "aggiungi": [
        {
          "block_type": "field",
          "key": "parte",
          "label": "Parte",
          "type": "select",
          "options": [
            "Venditore",
            "Acquirente"
          ]
        },
        {
          "block_type": "field",
          "key": "percentuale",
          "label": "Percentuale provvigione (%)",
          "type": "number"
        },
        {
          "block_type": "field",
          "key": "base_imponibile",
          "label": "Prezzo su cui si calcola",
          "type": "currency"
        },
        {
          "block_type": "field",
          "key": "importo_netto",
          "label": "Importo netto",
          "type": "computed",
          "expr": "if(percentuale > 0, round(base_imponibile * percentuale / 100, 2), importo)"
        },
        {
          "block_type": "field",
          "key": "iva",
          "label": "IVA 22%",
          "type": "computed",
          "expr": "round(importo_netto * 0.22, 2)"
        },
        {
          "block_type": "field",
          "key": "totale",
          "label": "Totale con IVA",
          "type": "computed",
          "expr": "round(importo_netto * 1.22, 2)"
        }
      ]
    },
    {
      "key": "requisiti_stato",
      "_nota": "«Per passare a… manca» sulla scheda della provvigione: solo promemoria.",
      "richiede": {
        "provvigioni": [
          "importo",
          "base_imponibile",
          "data_scadenza",
          "data_incasso"
        ]
      },
      "aggiungi": [
        {
          "block_type": "state_requirements",
          "stato": "fatturata",
          "bloccante": true,
          "requisiti": [
            {
              "label": "Importo",
              "tipo": "uno_di",
              "campi": [
                "importo",
                "base_imponibile"
              ]
            },
            {
              "label": "Data di scadenza",
              "tipo": "campo",
              "campo": "data_scadenza"
            }
          ]
        },
        {
          "block_type": "state_requirements",
          "stato": "incassata",
          "bloccante": true,
          "requisiti": [
            {
              "label": "Data di incasso",
              "tipo": "campo",
              "campo": "data_incasso"
            }
          ]
        }
      ]
    },
    {
      "key": "scaglioni",
      "_nota": "Scaglioni di provvigione: la percentuale proposta cambia con il prezzo su cui si calcola. SOGLIE E PERCENTUALI SONO UN ESEMPIO da adattare alle condizioni dell'agenzia (si modificano dal Builder nella formula del campo «Percentuale da scaglione»). Se la percentuale è scritta a mano vince quella.",
      "richiede": {
        "provvigioni": [
          "base_imponibile",
          "percentuale"
        ]
      },
      "aggiungi": [
        {
          "block_type": "field",
          "key": "percentuale_scaglione",
          "label": "Percentuale da scaglione",
          "type": "computed",
          "expr": "if(base_imponibile >= 500000, 2, if(base_imponibile >= 250000, 2.5, if(base_imponibile > 0, 3, 0)))"
        },
        {
          "block_type": "field",
          "key": "percentuale_applicata",
          "label": "Percentuale applicata",
          "type": "computed",
          "expr": "if(percentuale > 0, percentuale, percentuale_scaglione)"
        },
        {
          "block_type": "field",
          "key": "provvigione_scaglione",
          "label": "Provvigione da scaglione",
          "type": "computed",
          "expr": "round(base_imponibile * percentuale_applicata / 100, 2)"
        }
      ]
    },
    {
      "key": "scaglioni_nel_totale",
      "_nota": "Il totale della provvigione usa la «Percentuale applicata» (quella scritta a mano, altrimenti quella dello scaglione). Prima importo netto, IVA e totale usavano solo la percentuale scritta a mano e con la percentuale vuota davano 0 mentre lo scaglione proponeva un importo. Cambia le formule SOLO se sono ancora quelle originali (una formula modificata dal Builder non si tocca) e le sposta dopo i campi degli scaglioni, perché un calcolo vede solo i campi che lo precedono.",
      "richiede": {
        "provvigioni": [
          "importo",
          "base_imponibile",
          "percentuale",
          "importo_netto",
          "iva",
          "totale",
          "percentuale_applicata"
        ]
      },
      "ricalcola": [
        {
          "key": "importo_netto",
          "da": "if(percentuale > 0, round(base_imponibile * percentuale / 100, 2), importo)",
          "a": "if(percentuale_applicata > 0, round(base_imponibile * percentuale_applicata / 100, 2), importo)",
          "in_fondo": true
        },
        {
          "key": "iva",
          "da": "round(importo_netto * 0.22, 2)",
          "a": "round(importo_netto * 0.22, 2)",
          "in_fondo": true
        },
        {
          "key": "totale",
          "da": "round(importo_netto * 1.22, 2)",
          "a": "round(importo_netto * 1.22, 2)",
          "in_fondo": true
        }
      ]
    },
    {
      "key": "fattura_elettronica",
      "_nota": "Segnaposto «da attivare»: la fattura della provvigione richiede SDI attivo in OpenAPI.it.",
      "richiede": {
        "provvigioni": [
          "descrizione"
        ]
      },
      "aggiungi": [
        {
          "block_type": "external_action",
          "key": "fattura_elettronica",
          "label": "Fattura elettronica",
          "icon": "receipt",
          "descrizione": "Emette la fattura della provvigione e la manda allo SDI",
          "adapter": "da_attivare",
          "servizio_richiesto": "il servizio Fatturazione Elettronica (SDI) di OpenAPI.it",
          "come_attivare": "Attivalo nella console di OpenAPI.it e controllalo da Impostazioni → Connessioni → OpenAPI.it («Controlla i servizi»); poi la funzione verrà collegata."
        }
      ]
    },
    {
      "key": "minimo_garantito_campo",
      "_nota": "Il campo «Minimo garantito» della provvigione: se l'importo calcolato è più basso, vale il minimo. Il calcolo lo cambia l'estensione dopo, perché una formula vede solo i campi che la precedono.",
      "richiede": {
        "provvigioni": [
          "importo_netto"
        ]
      },
      "aggiungi": [
        {
          "block_type": "field",
          "key": "minimo_garantito",
          "label": "Minimo garantito",
          "type": "currency"
        }
      ]
    },
    {
      "key": "minimo_garantito_nel_totale",
      "_nota": "L'importo netto (e quindi IVA e totale) non scende sotto il minimo garantito, se indicato. Cambia le formule SOLO se sono ancora quelle degli scaglioni (una formula modificata dal Builder non si tocca).",
      "richiede": {
        "provvigioni": [
          "importo",
          "base_imponibile",
          "percentuale_applicata",
          "importo_netto",
          "iva",
          "totale",
          "minimo_garantito"
        ]
      },
      "ricalcola": [
        {
          "key": "importo_netto",
          "da": "if(percentuale_applicata > 0, round(base_imponibile * percentuale_applicata / 100, 2), importo)",
          "a": "if(minimo_garantito > if(percentuale_applicata > 0, round(base_imponibile * percentuale_applicata / 100, 2), importo), minimo_garantito, if(percentuale_applicata > 0, round(base_imponibile * percentuale_applicata / 100, 2), importo))",
          "in_fondo": true
        },
        {
          "key": "iva",
          "da": "round(importo_netto * 0.22, 2)",
          "a": "round(importo_netto * 0.22, 2)",
          "in_fondo": true
        },
        {
          "key": "totale",
          "da": "round(importo_netto * 1.22, 2)",
          "a": "round(importo_netto * 1.22, 2)",
          "in_fondo": true
        }
      ]
    },
    {
      "key": "trattenute_agente",
      "_nota": "Quanto della provvigione va all'agente: percentuale di trattenuta, importo trattenuto e quanto resta all'agenzia. Si calcola sull'importo netto (prima dell'IVA).",
      "richiede": {
        "provvigioni": [
          "importo_netto"
        ]
      },
      "aggiungi": [
        {
          "block_type": "field",
          "key": "agente",
          "label": "Agente",
          "type": "text"
        },
        {
          "block_type": "field",
          "key": "trattenuta_agente_perc",
          "label": "Trattenuta all'agente (%)",
          "type": "number"
        },
        {
          "block_type": "field",
          "key": "trattenuta_agente",
          "label": "Importo all'agente",
          "type": "computed",
          "expr": "round(importo_netto * trattenuta_agente_perc / 100, 2)"
        },
        {
          "block_type": "field",
          "key": "netto_agenzia",
          "label": "Resta all'agenzia",
          "type": "computed",
          "expr": "round(importo_netto - trattenuta_agente, 2)"
        }
      ]
    },
    {
      "key": "allinea_al_prezzo",
      "_nota": "Se il prezzo concordato della trattativa cambia, le provvigioni ancora «da fatturare» generate per parte (con trattativa e parte indicate) riprendono il nuovo prezzo: importi, IVA e totale seguono da soli. Controllo ogni giorno alle 05:00 UTC. Una provvigione già fatturata non si tocca.",
      "richiede": {
        "provvigioni": [
          "base_imponibile",
          "trattativa",
          "parte"
        ],
        "trattative": [
          "prezzo_concordato"
        ]
      },
      "aggiungi": [
        {
          "block_type": "automation",
          "label": "Provvigioni allineate al prezzo concordato",
          "trigger": {
            "evento": "schedulato",
            "schedulazione": {
              "tipo": "giornaliero",
              "ora": 5
            },
            "modalita": "per_record",
            "filtro": [
              {
                "campo": "_stato",
                "op": "==",
                "valore": "da_fatturare"
              },
              {
                "campo": "trattativa",
                "op": "!=",
                "valore": null
              },
              {
                "campo": "parte",
                "op": "!=",
                "valore": null
              }
            ]
          },
          "azioni": [
            {
              "target": "__interno__",
              "azione": "aggiorna_record",
              "config": {
                "modulo": "provvigioni",
                "id_field": "__self__",
                "campo": "base_imponibile",
                "operazione": "set",
                "valore": "relazione:trattativa:trattative:prezzo_concordato"
              }
            }
          ]
        }
      ]
    }
  ],
  "trattative": [
    {
      "key": "provvigioni_due_parti",
      "richiede": {
        "provvigioni": [
          "parte",
          "percentuale",
          "base_imponibile",
          "descrizione",
          "trattativa",
          "cliente",
          "tipo",
          "data_scadenza"
        ],
        "clienti": []
      },
      "aggiungi": [
        {
          "block_type": "relation",
          "key": "venditore",
          "label": "Venditore",
          "type": "many_to_one",
          "target_module": "clienti",
          "display_field": "nome"
        },
        {
          "block_type": "relation",
          "key": "acquirente",
          "label": "Acquirente",
          "type": "many_to_one",
          "target_module": "clienti",
          "display_field": "nome"
        },
        {
          "block_type": "field",
          "key": "prov_venditore_perc",
          "label": "Provvigione venditore (%)",
          "type": "number"
        },
        {
          "block_type": "field",
          "key": "prov_acquirente_perc",
          "label": "Provvigione acquirente (%)",
          "type": "number"
        },
        {
          "block_type": "field",
          "key": "provvigioni_generate_il",
          "label": "Provvigioni generate il",
          "type": "date"
        },
        {
          "block_type": "automation",
          "label": "Provvigioni alla firma del preliminare",
          "trigger": {
            "evento": "cambio_stato",
            "stato": "preliminare_firmato"
          },
          "azioni": [
            {
              "kind": "condition",
              "a": "provvigioni_generate_il",
              "op": "!=",
              "b": {
                "literal": "provvigioni_generate_il"
              },
              "then": [],
              "otherwise": [
                {
                  "kind": "condition",
                  "a": "prov_venditore_perc",
                  "op": ">",
                  "b": {
                    "literal": 0
                  },
                  "then": [
                    {
                      "target": "__interno__",
                      "azione": "crea_record",
                      "config": {
                        "modulo": "provvigioni",
                        "dati": {
                          "descrizione": "Provvigione venditore",
                          "trattativa": "__origine_id__",
                          "cliente": "campo:venditore",
                          "parte": "Venditore",
                          "tipo": "Provvigione preliminare",
                          "percentuale": "campo:prov_venditore_perc",
                          "base_imponibile": "campo:prezzo_concordato",
                          "data_scadenza": "campo:data_rogito",
                          "_stato": "da_fatturare"
                        }
                      }
                    },
                    {
                      "target": "__interno__",
                      "azione": "aggiorna_record",
                      "config": {
                        "modulo": "trattative",
                        "id_field": "__self__",
                        "campo": "provvigioni_generate_il",
                        "operazione": "set",
                        "valore": "_oggi_"
                      }
                    }
                  ],
                  "otherwise": []
                },
                {
                  "kind": "condition",
                  "a": "prov_acquirente_perc",
                  "op": ">",
                  "b": {
                    "literal": 0
                  },
                  "then": [
                    {
                      "target": "__interno__",
                      "azione": "crea_record",
                      "config": {
                        "modulo": "provvigioni",
                        "dati": {
                          "descrizione": "Provvigione acquirente",
                          "trattativa": "__origine_id__",
                          "cliente": "campo:acquirente",
                          "parte": "Acquirente",
                          "tipo": "Provvigione preliminare",
                          "percentuale": "campo:prov_acquirente_perc",
                          "base_imponibile": "campo:prezzo_concordato",
                          "data_scadenza": "campo:data_rogito",
                          "_stato": "da_fatturare"
                        }
                      }
                    },
                    {
                      "target": "__interno__",
                      "azione": "aggiorna_record",
                      "config": {
                        "modulo": "trattative",
                        "id_field": "__self__",
                        "campo": "provvigioni_generate_il",
                        "operazione": "set",
                        "valore": "_oggi_"
                      }
                    }
                  ],
                  "otherwise": []
                }
              ]
            }
          ]
        }
      ]
    },
